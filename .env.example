# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Better Auth derives its URL from localhost or Vercel's system environment
# variables; no BETTER_AUTH_URL/NEXT_PUBLIC_APP_URL is required.

# Added in the recommendation generation phase
AI_GATEWAY_API_KEY=
# TMDB v3 API key used by the server-side movie search service
TMBD_API_KEY=
CRON_SECRET=
